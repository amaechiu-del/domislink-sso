{
  "name": "domislink-sso-gateway-migration",
  "main": "recovered/index.js",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "WORKER": "domislink-sso-gateway",
    "APP_ORIGIN": "https://sso.domislink.com",
    "SSO_ISSUER": "https://sso.domislink.com",
    "SSO_ALLOWED_ORIGINS": "https://church.domislink.com",
    "OIDC_KEY_ID": "domislink-sso-2026",
    "WEBAUTHN_RP_ID": "domislink.com",
    "WEBAUTHN_RP_NAME": "DomisLink"
  },
  "observability": {
    "enabled": true
  }
}